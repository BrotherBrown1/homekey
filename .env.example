# LLM provider switch.
#   LLM_PROVIDER=anthropic   → Claude (default if ANTHROPIC_API_KEY is set)
#   LLM_PROVIDER=watsonx     → IBM Granite (use for hackathon demo)
# Leave blank to auto-detect (Anthropic preferred when key is present).
LLM_PROVIDER=anthropic

# Anthropic Claude — get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# IBM watsonx.ai credentials — see IBM_SETUP.md (kept for hackathon fallback)
IBM_CLOUD_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_REGION=us-south
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# watsonx Orchestrate (used by curator agent)
WATSONX_ORCHESTRATE_URL=

# Shared secret the Curator agent uses to authenticate to /api/skills/upsert-grant
CURATOR_AGENT_TOKEN=change-me-to-a-random-string
