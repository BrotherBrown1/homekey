# Copy to .env.local for local development, and set the same names in the
# Vercel project's Environment Variables for production.

# --- Lead notification (REQUIRED in production) --------------------------
# Without this, buyers who finish the quiz are never emailed to you, and on
# Vercel the SQLite database lives in ephemeral storage, so the lead can be
# lost entirely. Free tier at https://resend.com is 100 emails/day.
RESEND_API_KEY=
# Optional overrides; defaults are the Resend sandbox sender and the
# realtor address in lib/config.ts.
LEAD_NOTIFY_FROM=
LEAD_NOTIFY_TO=

# --- Lead storage (REQUIRED in production) -------------------------------
# On Vercel the SQLite file lives in /tmp, which is per-instance and wiped
# on every redeploy, so leads written there are eventually lost. Set a
# Postgres connection string and leads are stored durably instead.
# Works with any provider — Vercel Postgres, Neon, Supabase. Use the
# provider's POOLED connection string on serverless.
# Leave blank for local development: it falls back to data/homekey.db.
POSTGRES_URL=

# --- Admin page (REQUIRED in production) ---------------------------------
# /admin lists every lead, including phone numbers and household income.
# proxy.ts refuses to serve the page unless ADMIN_PASSWORD is set.
ADMIN_PASSWORD=
ADMIN_USER=admin

# --- LLM provider (needed for the weekly Curator and AI validation) ------
# The Curator re-checks every program's source page; without a key it
# cannot run, and the "updated within 7 days" claim will not hold.
ANTHROPIC_API_KEY=
# Optional: pin the provider or model. Defaults to Anthropic when its key
# is present, otherwise watsonx.
LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=

# --- IBM watsonx (only if LLM_PROVIDER=watsonx) --------------------------
IBM_CLOUD_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_REGION=
WATSONX_MODEL_ID=

# --- Cron ----------------------------------------------------------------
# Vercel injects this automatically for scheduled functions; set it locally
# only if you want to call /api/cron/curator by hand.
CRON_SECRET=

# --- Misc ----------------------------------------------------------------
# Set to "false" in production so the demo leads are not seeded into /admin.
DEMO_MODE=false
